{
  "name": "gas-rbac",
  "version": "0.0.0",
  "description": "Role-based access control for Google Apps Script web apps",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./gas": "./src/gas/index.ts"
  },
  "scripts": {
